# backend/.env.example — copy to backend/.env and fill in.
# .env is git-ignored; NEVER commit real keys. Single-user, self-hosted (D11/D12).
#
# Alpaca PAPER account credentials only. v1 is hard paper-locked (D25): the app
# is physically unable to reach a live endpoint, so these are always paper keys.
ALPACA_KEY=your-alpaca-paper-key-id
ALPACA_SECRET=your-alpaca-paper-secret-key

# Anthropic API key for the Claude parser (D14). Each user brings their own (D13).
ANTHROPIC_API_KEY=sk-ant-your-key

# Optional: Claude model id for the parser (B-1/D50). Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5
